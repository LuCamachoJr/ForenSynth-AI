{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ai-findings",
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "inferred",
              "hypothesis"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "confidence_rationale": {
            "type": "string"
          },
          "alternative_explanations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "statement",
          "evidence_refs",
          "classification",
          "confidence",
          "confidence_rationale",
          "alternative_explanations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "findings"
  ],
  "additionalProperties": false
}
